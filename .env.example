# ---------------------------------------------------------------------------
# Copy to `.env` and adjust. NEVER commit a real `.env`.
# Every value below is read by config.py (Pydantic Settings, case-insensitive).
# ---------------------------------------------------------------------------

# --- Application ---
APP_NAME="Multi-Tenant Enterprise Knowledge RAG Engine"
API_PREFIX="/api/v1"
ENVIRONMENT=development            # development | staging | production | test
DEBUG=true
LOG_LEVEL=INFO
ALLOWED_ORIGINS=["http://localhost:3000"]

# --- PostgreSQL ---
POSTGRES_USER=rag
POSTGRES_PASSWORD=rag_dev_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_engine
# DATABASE_URL=postgresql+psycopg2://user:pass@host:5432/db   # optional full-DSN override

# --- Connection pool ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# --- pgvector / retrieval ---
PGVECTOR_EXTENSION=vector
EMBEDDING_DIMENSION=1536           # one of 384, 768, 1024, 1536, 3072 (requires migration to change)
EMBEDDING_MODEL=text-embedding-3-small
DISTANCE_STRATEGY=cosine           # cosine | l2 | inner_product
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
CHUNK_SIZE=1024
CHUNK_OVERLAP=128
RETRIEVAL_TOP_K=8
RETRIEVAL_MIN_SCORE=0.0

# --- Auth / JWT (RBAC) ---
SECRET_KEY=dev-insecure-secret-change-me      # >= 32 chars, required when ENVIRONMENT=production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=14

# --- LLM (llama-index) ---
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024
OPENAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
REQUEST_TIMEOUT_SECONDS=60

# --- Audit logging ---
AUDIT_ENABLED=true
AUDIT_SLOW_QUERY_MS=1000
AUDIT_STORE_RESPONSE_SNIPPET=false
AUDIT_RESPONSE_SNIPPET_CHARS=512
